@startuml
' Process model of a sale at the counter - Inventory & POS System v0.20.4 (report, Lecture 5; redrawn 2026-10-12)
' Edit: paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  LifeLineBorderColor #888888
  ActorBorderColor Black
  ActorBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9B458
}
skinparam swimlaneWidth same
hide circle

|Customer|
start
:Orders drinks and pastries;
|Cashier|
:Taps + Hot / + Iced (or + Add) on each tile;
|System|
:Checks stock and ingredients;
if (Enough?) then (yes)
  :Adds the line; shows what is left
and which ingredients the order uses;
else (no)
  :Greys out the tile / names the missing ingredient;
  |Cashier|
  :Tells the customer, changes the order;
  |System|
endif
|Cashier|
:If needed, taps a basket line:
changes serving / add-ons, - / +;
|Customer|
:Pays by cash or GCash;
|Cashier|
if (Payment?) then (cash)
  :Taps a quick amount (Exact, 500...)
or types the cash received;
else (GCash)
  :Types the 13-digit reference;
endif
:Taps Complete Sale;
|System|
:Checks everything again,
and that this basket was not sold already;
:Saves the sale, lowers stock and ingredients (one transaction);
:Shows the receipt;
|Cashier|
:Prints the receipt, gives change;
|Customer|
:Receives order and receipt;
stop
@enduml
