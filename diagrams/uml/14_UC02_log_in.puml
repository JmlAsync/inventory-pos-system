@startuml
' Use case UC02 Log in - Inventory & POS System v0.32.0 (report, Lecture 5-7; redrawn 2026-10-27)
' Edit: paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  LifeLineBorderColor #888888
  ActorBorderColor Black
  ActorBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9B458
}
skinparam swimlaneWidth same
hide circle

left to right direction
actor "Visitor" as A0
actor "Email server" as S0 <<system>>
actor "Google" as S1 <<system>>
usecase "Log in" as U
usecase "Check login limit" as I0
U ..> I0 : <<include>>
usecase "Enter the login code\n(unless the browser is trusted)" as I1
U ..> I1 : <<include>>
usecase "Start a login record" as I2
U ..> I2 : <<include>>
usecase "Sign in with Google" as E0
E0 ..> U : <<extend>>
usecase "Reset a forgotten password" as E1
E1 ..> U : <<extend>>
A0 -- U
U -- S0
U -- S1
note right of U
  UC02: Password, then a 6-digit code. 5 wrong passwords = wait 5 minutes.
  The login ends on log-out, password change or 8 idle hours
end note
@enduml
