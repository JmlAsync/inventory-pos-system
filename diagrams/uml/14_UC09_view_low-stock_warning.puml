@startuml
' Use case UC09 View low-stock warning - Inventory & POS System v0.20.4 (report, Lecture 5; redrawn 2026-10-12)
' Edit: paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  LifeLineBorderColor #888888
  ActorBorderColor Black
  ActorBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9B458
}
skinparam swimlaneWidth same
hide circle

left to right direction
actor "Cashier" as Cashier
actor "Admin" as Admin
usecase "View low-stock warning" as U
Cashier -- U
Admin -- U
usecase "View product list" as UC04
U ..> UC04 : <<extend>>
usecase "Process sale" as UC08
U ..> UC08 : <<extend>>
note right of U
  UC09: Extends UC04 and UC08 when stock is low:
  badges on Products, banner and greyed tiles on New Sale
end note
@enduml
