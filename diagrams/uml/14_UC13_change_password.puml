@startuml
' Use case UC13 Change password - Inventory & POS System v0.20.4 (report, Lecture 5; redrawn 2026-10-12)
' Edit: paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  LifeLineBorderColor #888888
  ActorBorderColor Black
  ActorBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9B458
}
skinparam swimlaneWidth same
hide circle

left to right direction
actor "User" as User
usecase "Change password" as U
usecase "End the other logins" as I0
U ..> I0 : <<include>>
User -- U
note right of U
  UC13: 8+ characters, not the username;
  every other device logged in as you is logged out
end note
@enduml
