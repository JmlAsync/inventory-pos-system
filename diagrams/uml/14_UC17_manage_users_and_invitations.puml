@startuml
' Use case UC17 Manage users and invitations - Inventory & POS System v0.32.0 (report, Lecture 5-7; redrawn 2026-10-27)
' Edit: paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  LifeLineBorderColor #888888
  ActorBorderColor Black
  ActorBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9B458
}
skinparam swimlaneWidth same
hide circle

left to right direction
actor "Owner" as A0
actor "Admin (allowed to invite)" as A1
actor "Email server" as S0 <<system>>
usecase "Manage users and invitations" as U
usecase "Check permission (role)" as I0
U ..> I0 : <<include>>
usecase "Write an audit line" as I1
U ..> I1 : <<include>>
usecase "Switch an account off" as E0
E0 ..> U : <<extend>>
usecase "Require a new password" as E1
E1 ..> U : <<extend>>
A0 -- U
A1 -- U
U -- S0
note right of U
  UC17: Invite by email (48 hours, once, role fixed by the inviter);
  only the owner changes roles; accounts are switched off, never deleted
end note
@enduml
