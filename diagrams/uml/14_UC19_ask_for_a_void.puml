@startuml
' Use case UC19 Ask for a void - Inventory & POS System v0.32.0 (report, Lecture 5-7; redrawn 2026-10-27)
' Edit: paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  LifeLineBorderColor #888888
  ActorBorderColor Black
  ActorBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9B458
}
skinparam swimlaneWidth same
hide circle

left to right direction
actor "Cashier" as A0
actor "Admin" as A1
actor "Email server" as S0 <<system>>
usecase "Ask for a void" as U
usecase "Check permission (role)" as I0
U ..> I0 : <<include>>
usecase "Email an admin\nfor a code" as E0
E0 ..> U : <<extend>>
A0 -- U
A1 -- U
U -- S0
note right of U
  UC19: Today's receipts only, with a reason;
  nothing changes until an admin decides
end note
@enduml
