@startuml
' Use case UC20 Approve or reject a void - Inventory & POS System v0.32.0 (report, Lecture 5-7; redrawn 2026-10-27)
' Edit: paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  LifeLineBorderColor #888888
  ActorBorderColor Black
  ActorBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9B458
}
skinparam swimlaneWidth same
hide circle

left to right direction
actor "Admin" as A0
actor "Email server" as S0 <<system>>
usecase "Approve or reject a void" as U
usecase "Check permission (role)" as I0
U ..> I0 : <<include>>
usecase "Put the stock back" as I1
U ..> I1 : <<include>>
usecase "Write an audit line" as I2
U ..> I2 : <<include>>
A0 -- U
U -- S0
note right of U
  UC20: With the admin's own password, or the code emailed to them;
  the receipt itself never changes
end note
@enduml
