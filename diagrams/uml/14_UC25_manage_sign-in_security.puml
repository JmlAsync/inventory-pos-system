@startuml
' Use case UC25 Manage sign-in security - Inventory & POS System v0.32.0 (report, Lecture 5-7; redrawn 2026-10-27)
' Edit: paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  LifeLineBorderColor #888888
  ActorBorderColor Black
  ActorBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9B458
}
skinparam swimlaneWidth same
hide circle

left to right direction
actor "Cashier" as A0
actor "Admin" as A1
usecase "Manage sign-in security" as U
usecase "Ask for the password\nand a current code" as I0
U ..> I0 : <<include>>
usecase "Link Google" as E0
E0 ..> U : <<extend>>
usecase "Use an authenticator app" as E1
E1 ..> U : <<extend>>
A0 -- U
A1 -- U
note right of U
  UC25: Trusted devices, Log out everywhere, 10 backup codes,
  authenticator app, Google link
end note
@enduml
