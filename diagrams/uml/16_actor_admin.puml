@startuml
' Use cases of the Admin - Inventory & POS System v0.32.0 (report, Lecture 5-7; redrawn 2026-10-27)
' Edit: paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  LifeLineBorderColor #888888
  ActorBorderColor Black
  ActorBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9B458
}
skinparam swimlaneWidth same
hide circle

left to right direction
actor "Admin" as A
rectangle "Inventory & POS System" {
  usecase "UC01 View home page" as UC01
  usecase "UC03 Log out" as UC03
  usecase "UC04 View product list" as UC04
  usecase "UC08 Process sale" as UC08
  usecase "UC11 Change profile picture" as UC11
  usecase "UC12 Switch light/dark theme" as UC12
  usecase "UC13 Change password" as UC13
  usecase "UC19 Ask for a void" as UC19
  usecase "UC24 Read the help" as UC24
  usecase "UC25 Manage sign-in security" as UC25
  usecase "UC09 View low-stock warning" as UC09
  usecase "UC05 Add product" as UC05
  usecase "UC06 Edit product" as UC06
  usecase "UC07 Delete product" as UC07
  usecase "UC10 View sales report" as UC10
  usecase "UC14 Manage servings and add-ons" as UC14
  usecase "UC15 Manage ingredients and recipes" as UC15
  usecase "UC16 Edit shop details" as UC16
  usecase "UC20 Approve or reject a void" as UC20
  usecase "UC21 Refund items" as UC21
  usecase "UC22 View audit log" as UC22
}
A -- UC01
A -- UC03
A -- UC04
A -- UC08
A -- UC11
A -- UC12
A -- UC13
A -- UC19
A -- UC24
A -- UC25
A -- UC09
A -- UC05
A -- UC06
A -- UC07
A -- UC10
A -- UC14
A -- UC15
A -- UC16
A -- UC20
A -- UC21
A -- UC22
@enduml
