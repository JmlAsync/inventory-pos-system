@startuml
' Use cases of the Cashier - Inventory & POS System v0.32.0 (report, Lecture 5-7; redrawn 2026-10-27)
' Edit: paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  LifeLineBorderColor #888888
  ActorBorderColor Black
  ActorBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9B458
}
skinparam swimlaneWidth same
hide circle

left to right direction
actor "Cashier" as A
rectangle "Inventory & POS System" {
  usecase "UC01 View home page" as UC01
  usecase "UC03 Log out" as UC03
  usecase "UC04 View product list" as UC04
  usecase "UC08 Process sale" as UC08
  usecase "UC11 Change profile picture" as UC11
  usecase "UC12 Switch light/dark theme" as UC12
  usecase "UC13 Change password" as UC13
  usecase "UC19 Ask for a void" as UC19
  usecase "UC24 Read the help" as UC24
  usecase "UC25 Manage sign-in security" as UC25
  usecase "UC09 View low-stock warning" as UC09
}
A -- UC01
A -- UC03
A -- UC04
A -- UC08
A -- UC11
A -- UC12
A -- UC13
A -- UC19
A -- UC24
A -- UC25
A -- UC09
@enduml
