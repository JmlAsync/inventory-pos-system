@startuml
' Use cases of the Cashier - Inventory & POS System v0.18.2 (report, Lecture 5)
' Edit: paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  LifeLineBorderColor #888888
  ActorBorderColor Black
  ActorBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9B458
}
skinparam swimlaneWidth same
hide circle

left to right direction
actor "Cashier" as A
rectangle "Inventory & POS System" {
  usecase "UC01 View home page (dashboard)" as U0
  usecase "UC03 Log out" as U1
  usecase "UC04 View product list" as U2
  usecase "UC08 Process sale" as U3
  usecase "UC09 View low-stock warning" as U4
  usecase "UC11 Change profile picture" as U5
  usecase "UC12 Switch light/dark theme" as U6
  usecase "UC13 Change password" as U7
}
A -- U0
A -- U1
A -- U2
A -- U3
A -- U4
A -- U5
A -- U6
A -- U7
@enduml
