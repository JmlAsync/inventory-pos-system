@startuml
' Use cases of the Visitor - Inventory & POS System v0.32.0 (report, Lecture 5-7; redrawn 2026-10-27)
' Edit: paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  LifeLineBorderColor #888888
  ActorBorderColor Black
  ActorBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9B458
}
skinparam swimlaneWidth same
hide circle

left to right direction
actor "Visitor" as A
rectangle "Inventory & POS System" {
  usecase "UC01 View home page" as UC01
  usecase "UC02 Log in" as UC02
  usecase "UC12 Switch light/dark theme" as UC12
  usecase "UC18 Join by invitation" as UC18
  usecase "UC23 Reset a forgotten password" as UC23
  usecase "UC24 Read the help" as UC24
}
A -- UC01
A -- UC02
A -- UC12
A -- UC18
A -- UC23
A -- UC24
@enduml
