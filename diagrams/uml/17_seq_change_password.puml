@startuml
' Sequence: change password - Inventory & POS System v0.18.2 (report, Lecture 5)
' Edit: paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  LifeLineBorderColor #888888
  ActorBorderColor Black
  ActorBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9B458
}
skinparam swimlaneWidth same
hide circle

actor User
participant "Profile page\n(browser)" as UI
participant "change_password()\n(app.py)" as C
database "User table" as DB
User -> UI : current, new, new again
UI -> C : POST /profile/password (CSRF)
C -> C : current correct? new = again? not the username? 8+ characters?
alt any check fails
  C --> UI : message, nothing changed
else all fine
  C -> DB : save generate_password_hash(new)
  C --> UI : "Password changed"
end
@enduml
