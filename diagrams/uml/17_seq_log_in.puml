@startuml
' Sequence: log in with a code - Inventory & POS System v0.32.0 (report, Lecture 5-7; redrawn 2026-10-27)
' Edit: paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  LifeLineBorderColor #888888
  ActorBorderColor Black
  ActorBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9B458
}
skinparam swimlaneWidth same
hide circle

actor User
participant "Login page\n(browser)" as UI
participant "login() / verify()\n(blueprints/accounts.py)" as C
database "login_attempt" as L
database "user, trusted_device,\nemail_code" as DB
participant "Email server" as M
User -> UI : types username and password
UI -> C : POST /login (+ CSRF token)
C -> L : wrong tries for (username, computer)\nin the last 5 minutes?
alt 5 or more
  C --> UI : 429 "Too many failed attempts"
else fewer than 5
  C -> DB : find user by username
  C -> C : check the password hash\n(a dummy hash if no such user)
  alt wrong
    C -> L : record a try (keyed hash)
    C --> UI : "Invalid username or password"
  else right, browser trusted for this user
    C -> DB : INSERT login_session (random token)
    C --> UI : logged in
  else right, not trusted
    C -> DB : save a new code (keyed hash, 10 minutes)
    C -> M : email the 6-digit code
    C --> UI : the code page (/verify)
    User -> UI : types the code (and "Trust this browser")
    UI -> C : POST /verify
    C -> DB : compare hashes in constant time;\nmark the code used
    C -> DB : INSERT login_session;\ntrusted_device if ticked
    C --> UI : logged in
  end
end
@enduml
