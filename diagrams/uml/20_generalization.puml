@startuml
' Generalization hierarchy - Inventory & POS System v0.32.0 (report, Lecture 5-7; redrawn 2026-10-27)
' Edit: paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  LifeLineBorderColor #888888
  ActorBorderColor Black
  ActorBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9B458
}
skinparam swimlaneWidth same
hide circle

class User {
  username, password_hash
  email, avatar
  --
  log in (password + code) / log out
  process sale, undo
  ask for a void
  read the help
}
class Cashier {
  role = "cashier"
}
class Admin {
  role = "admin"
  --
  products, servings, ingredients
  sales report, approve voids, refunds
  shop details, email, audit log
}
class Owner {
  role = "owner" (only one)
  --
  invite anyone, change roles
  let admins invite
  can't be switched off
}
User <|-- Cashier
User <|-- Admin
Admin <|-- Owner
class SaleAdjustment {
  total, reason
  requested_by, decided_by
}
class Void {
  kind = "void"
  --
  whole receipt, today only
}
class Refund {
  kind = "refund"
  --
  chosen items, any day,
  admins only
}
SaleAdjustment <|-- Void
SaleAdjustment <|-- Refund
class MenuOption {
  name, price, active
}
class Serving {
  kind = "size"
  --
  exactly one per drink
}
class AddOn {
  kind = "addon"
  --
  any number per drink
}
MenuOption <|-- Serving
MenuOption <|-- AddOn
class IngredientMovement {
  change, user, created_at
}
class "Sale / Void / Refund" as SaleUse {
  reason = sale, void, refund
}
class "Restock / Count" as Restock {
  reason = restock, count, count-undo
}
class Waste {
  reason = waste
}
IngredientMovement <|-- SaleUse
IngredientMovement <|-- Restock
IngredientMovement <|-- Waste
note right of User
  In the code these are ONE table each,
  with a "role" / "kind" / "reason" column
  saying which kind it is.
end note
@enduml
