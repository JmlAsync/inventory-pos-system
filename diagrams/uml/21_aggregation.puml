@startuml
' Aggregation and composition - Inventory & POS System v0.32.0 (report, Lecture 5-7; redrawn 2026-10-27)
' Edit: paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  LifeLineBorderColor #888888
  ActorBorderColor Black
  ActorBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9B458
}
skinparam swimlaneWidth same
hide circle

class Sale
class SaleItem
Sale "1" *-- "1..*" SaleItem : composition
class SaleItemUsage
SaleItem "1" *-- "0..*" SaleItemUsage : composition
class SaleAdjustment
class AdjustmentLine
SaleAdjustment "1" *-- "1..*" AdjustmentLine : composition
class "Recipe of a product" as Recipe
class RecipeItem
Recipe "1" o-- "0..*" RecipeItem : aggregation
class Ingredient
RecipeItem "0..*" --> "1" Ingredient : uses
class "Basket (session)" as Basket
class "Basket line" as Line
Basket "1" o-- "0..*" Line : aggregation
class "Undo copies (last 5)" as UndoList
Basket "1" *-- "0..5" UndoList : composition
class User
class LoginSession
class TrustedDevice
class BackupCode
User "1" *-- "0..*" LoginSession : composition
User "1" *-- "0..*" TrustedDevice : composition
User "1" *-- "0..*" BackupCode : composition
note right of Sale
  Filled diamond: the part cannot exist without
  its whole (a receipt line without its receipt,
  a void line without its void, a backup code
  without its user).
  Hollow diamond: the parts exist on their own
  (an ingredient exists without any recipe).
end note
@enduml
