@startuml
' Layered architecture - Inventory & POS System v0.32.0 (report, Lecture 5-7; redrawn 2026-10-27)
' Edit: paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  LifeLineBorderColor #888888
  ActorBorderColor Black
  ActorBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9B458
}
skinparam swimlaneWidth same
hide circle

skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
rectangle "<b>1. User interface</b>\nHTML pages (Jinja2 templates), theme.css (light / dark), Bootstrap 5.3.3, Bootstrap Icons,\nInter font, help panel (help_topics.py, static/help), small scripts (change preview, quick cash, Saving...)" as ui
rectangle "<b>2. User communication and security</b>\nFlask blueprints (accounts, sales, adjustments, catalog, ingredients, reports, shop, users, help),\nlogin records and codes, trusted devices, admin_required (403), CSRF check, login limit, headers, upload checks" as sec
rectangle "<b>3. Application logic</b>\nBasket, undo and sale ticket, stock and recipe checks, payments (cash, GCash), voids and refunds,\nnet sales, invitations, email (mail.py), authenticator codes (totp.py), Google (google_signin.py)" as logic
rectangle "<b>4. Data access</b>\nstore/ (every database change: one named operation, conditional updates, audit lines),\nSQLAlchemy models (models.py), Alembic migrations 0001-0008 (migrations/)" as data
rectangle "<b>5. Storage</b>\nSQLite file instance/inventory.db (PostgreSQL for the cloud package), instance/config.toml,\nsecret and key files, pictures in static/products and static/avatars" as store
ui -down-> sec
sec -down-> logic
logic -down-> data
data -down-> store
note right of sec
  Each layer only uses
  the layer below it.
  Since v0.25.0 a page that
  writes to the database itself
  fails the contract check.
end note
@enduml
