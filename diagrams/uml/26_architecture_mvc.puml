@startuml
' MVC architecture - Inventory & POS System v0.32.0 (report, Lecture 5-7; redrawn 2026-10-27)
' Edit: paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  LifeLineBorderColor #888888
  ActorBorderColor Black
  ActorBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9B458
}
skinparam swimlaneWidth same
hide circle

left to right direction
actor "Cashier / Admin / Owner" as person
rectangle "Browser\n(Chrome, Edge or Firefox\non the counter laptop or a phone)" as browser
package "Flask application (waitress: serve.py)" {
  rectangle "<b>Controller</b>\nRoutes in 9 blueprints\n(blueprints/*.py: 67 pages and actions,\nnew_sale, complete_sale, approve_void,\nverify, invite, sales_report ...)\n+ checks: login, code, admin, CSRF,\nform values" as controller
  rectangle "<b>View</b>\nJinja2 templates\n(templates/*.html)\n+ theme.css, Bootstrap,\nicons, Inter font\n(static/vendor), help panel" as view
  rectangle "<b>Model</b>\nstore/ operations\n(record_sale, approve_void,\nrestock, create_invitation ...)\n+ SQLAlchemy classes\n(models.py: 19 tables)" as model
}
database "SQLite\ninstance/inventory.db" as db
person --> browser : taps, types
browser --> controller : 1. HTTP request\n(GET page / POST form\nwith CSRF token)
controller --> model : 2. read / change data\n(only through store/)
model --> db : 3. SQL (one transaction\nper operation)
controller --> view : 4. render page\nwith the data
view --> browser : 5. HTML page\n(or redirect)
@enduml
