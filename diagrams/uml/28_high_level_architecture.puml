@startuml
' High-level architecture - Inventory & POS System v0.32.0 (report, Lecture 5-7; redrawn 2026-10-27)
' Edit: paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  LifeLineBorderColor #888888
  ActorBorderColor Black
  ActorBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9B458
}
skinparam swimlaneWidth same
hide circle

skinparam package {
  BackgroundColor White
  BorderColor Black
}
rectangle "Web interface\n(templates, theme, menus,\nhelp on every page)" <<subsystem>> as web
rectangle "Accounts and security\n(log in with a code, trusted devices,\nbackup codes, Google, passwords)" <<subsystem>> as acc
rectangle "Users and audit\n(owner, invitations, roles,\nswitch off, audit log)" <<subsystem>> as users
rectangle "Sales\n(New Sale, basket, undo,\nsale ticket, payments, receipts)" <<subsystem>> as sales
rectangle "Adjustments\n(voids with approval,\nrefunds, slips)" <<subsystem>> as adj
rectangle "Product catalogue\n(products, pictures,\nservings and add-ons)" <<subsystem>> as cat
rectangle "Ingredients\n(ingredients, recipes, restock,\nsafe count, undo, history)" <<subsystem>> as ing
rectangle "Reporting and shop\n(Home, net sales report,\nshop details, email settings)" <<subsystem>> as rep
rectangle "Flask request handling (blueprints)" as link
rectangle "Data storage\n(store/, SQLAlchemy + SQLite,\nmigrations, picture files)" <<subsystem>> as store
rectangle "Email\n(mail.py, smtplib)" <<subsystem>> as mail
web -down- link
acc -up- link
users -up- link
sales -up- link
adj -up- link
cat -up- link
ing -up- link
rep -up- link
link -down- store
link -down- mail
@enduml
