@startuml
' Object classes - Inventory & POS System v0.32.0 (report, Lecture 5-7; redrawn 2026-10-27)
' Edit: paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  LifeLineBorderColor #888888
  ActorBorderColor Black
  ActorBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9B458
}
skinparam swimlaneWidth same
hide circle

skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
class Basket <<kept in the session>> {
  lines, sale ticket, undo copies
  --
  new_sale(), change_line_options()
  undo_basket(), remove_line()
}
class Sale {
  total, payment, ticket
  voided_at, refunded_total
  --
  complete_sale() -> store.sales.record_sale()
  receipt(), net_total()
}
class SaleAdjustment {
  kind, status, total
  reason, who asked / decided
  --
  request_void(), approve_void()
  reject_void(), void_now(), refund()
}
class Product {
  name, sku, price
  quantity, category, image
  --
  validate_product_form()
  can_make(), menu_tile()
}
class Ingredient {
  name, unit, quantity
  low_at, full_at
  --
  restock(), count(), undo_count()
  stock_status()
}
class User {
  username, role, email
  second_step, google_sub
  --
  login(), verify(), logout()
  change_password(), profile()
}
class Invitation {
  email, role, expires_at
  --
  invite(), signup()
  resend / cancel
}
class TrustedDevice {
  token_hash, expires_at
  --
  trust_device(), remove_device()
  logout_everywhere()
}
class AuditEntry {
  action, target, details
  --
  note(), audit()
}
class SalesReport <<page, no table>> {
  dates; gross, voids, refunds, net
  --
  sales_report()
}
class HelpTopic <<help_topics.py>> {
  title, summary, steps, picture
  --
  help_page(), help panel
}
Basket ..> Product : lines name
Basket ..> Sale : becomes
SaleAdjustment --> Sale : points to
Sale --> User : cashier
User *-- TrustedDevice
Invitation ..> User : makes
AuditEntry --> User : who
SalesReport ..> Sale
SalesReport ..> SaleAdjustment
@enduml
