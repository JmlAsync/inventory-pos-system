@startuml
' Use case diagram - Inventory & POS System (v0.17.2: all use cases built)
' Paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
' Lines starting with an apostrophe are comments and are not drawn.

left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

actor Visitor
actor User
actor Admin
actor Cashier

' Generalization: Admin and Cashier are kinds of User
User <|-- Admin
User <|-- Cashier

rectangle "Inventory & POS System" {
  usecase "View home page" as UC01
  usecase "Log in" as UC02
  usecase "Log out" as UC03
  usecase "View product list" as UC04
  usecase "Add product" as UC05
  usecase "Edit product" as UC06
  usecase "Delete product" as UC07
  usecase "Check permission\n(role)" as CHK
  usecase "Process sale" as UC08
  usecase "View low-stock warning" as UC09
  usecase "View sales report" as UC10
  usecase "Change profile picture" as UC11
  usecase "Switch light/dark theme" as UC12
  usecase "Change password" as UC13
  usecase "Manage servings\n(hot/iced) and add-ons" as UC14
  usecase "Manage ingredients\nand recipes" as UC15
}

Visitor -- UC01
Visitor -- UC02
Visitor -- UC12

User -- UC03
User -- UC04
User -- UC08
User -- UC11
User -- UC12
User -- UC13

Admin -- UC05
Admin -- UC06
Admin -- UC07
Admin -- UC10
Admin -- UC14
Admin -- UC15

UC05 ..> CHK : <<include>>
UC06 ..> CHK : <<include>>
UC07 ..> CHK : <<include>>
UC08 ..> CHK : <<include>>
UC10 ..> CHK : <<include>>
UC14 ..> CHK : <<include>>
UC15 ..> CHK : <<include>>

UC09 ..> UC04 : <<extend>>
@enduml
