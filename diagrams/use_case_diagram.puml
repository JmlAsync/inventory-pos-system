@startuml
' Use case diagram (all use cases) - Inventory & POS System v0.32.0 (report, Lecture 5-7; redrawn 2026-10-27)
' Edit: paste into draw.io (Arrange > Insert > Advanced > PlantUML) or planttext.com
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #E6F1EE
}
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam sequence {
  ParticipantBackgroundColor White
  ParticipantBorderColor Black
  LifeLineBorderColor #888888
  ActorBorderColor Black
  ActorBackgroundColor White
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9B458
}
skinparam swimlaneWidth same
hide circle

left to right direction
actor Visitor
actor User
actor Cashier
actor Admin
actor Owner
actor "Email server" as Mail <<system>>
actor "Google" as Google <<system>>
User <|-- Cashier
User <|-- Admin
Admin <|-- Owner
rectangle "Inventory & POS System" {
  usecase "View home page" as UC01
  usecase "Log in" as UC02
  usecase "Log out" as UC03
  usecase "View product list" as UC04
  usecase "Add product" as UC05
  usecase "Edit product" as UC06
  usecase "Delete product" as UC07
  usecase "Process sale" as UC08
  usecase "View low-stock warning" as UC09
  usecase "View sales report" as UC10
  usecase "Change profile picture" as UC11
  usecase "Switch light/dark theme" as UC12
  usecase "Change password" as UC13
  usecase "Manage servings\nand add-ons" as UC14
  usecase "Manage ingredients\nand recipes" as UC15
  usecase "Edit shop details" as UC16
  usecase "Manage users\nand invitations" as UC17
  usecase "Join by invitation" as UC18
  usecase "Ask for a void" as UC19
  usecase "Approve or reject a void" as UC20
  usecase "Refund items" as UC21
  usecase "View audit log" as UC22
  usecase "Reset\na forgotten password" as UC23
  usecase "Read the help" as UC24
  usecase "Manage sign-in security" as UC25
  usecase "Check permission\n(role)" as CHK
  usecase "Enter the\nlogin code" as CODE
  usecase "Start / end a\nlogin record" as REC
  usecase "One receipt per basket\n(sale ticket)" as TICKET
  usecase "Change a basket line" as LINE
  usecase "Undo a change" as UNDO
}
Visitor -- UC01
Visitor -- UC02
Visitor -- UC12
Visitor -- UC18
Visitor -- UC23
Visitor -- UC24
User -- UC03
User -- UC04
User -- UC08
User -- UC11
User -- UC12
User -- UC13
User -- UC19
User -- UC24
User -- UC25
Admin -- UC05
Admin -- UC06
Admin -- UC07
Admin -- UC10
Admin -- UC14
Admin -- UC15
Admin -- UC16
Admin -- UC20
Admin -- UC21
Admin -- UC22
Owner -- UC17
UC05 ..> CHK : <<include>>
UC06 ..> CHK : <<include>>
UC07 ..> CHK : <<include>>
UC10 ..> CHK : <<include>>
UC14 ..> CHK : <<include>>
UC15 ..> CHK : <<include>>
UC16 ..> CHK : <<include>>
UC20 ..> CHK : <<include>>
UC21 ..> CHK : <<include>>
UC22 ..> CHK : <<include>>
UC17 ..> CHK : <<include>>
UC02 ..> CODE : <<include>>
UC02 ..> REC : <<include>>
UC03 ..> REC : <<include>>
UC08 ..> TICKET : <<include>>
LINE ..> UC08 : <<extend>>
UNDO ..> UC08 : <<extend>>
UC09 ..> UC04 : <<extend>>
UC23 ..> UC02 : <<extend>>
CODE -- Mail
UC17 -- Mail
UC20 -- Mail
UC02 -- Google
@enduml
